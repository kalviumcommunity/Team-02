rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function isStoreManager() {
      return isAuthenticated() && (getUserRole() == 'store_manager' || getUserRole() == 'admin');
    }
    
    function isPlanner() {
      return isAuthenticated() && (getUserRole() == 'replenishment_planner' || getUserRole() == 'admin');
    }
    
    function isWarehouseDispatcher() {
      return isAuthenticated() && (getUserRole() == 'warehouse_dispatcher' || getUserRole() == 'admin');
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Requests Collection Rules
    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isStoreManager();
      allow update: if isPlanner() || isWarehouseDispatcher() || isStoreManager();
      allow delete: if isAdmin();
    }

    // Exceptions Collection Rules
    match /exceptions/{exceptionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Audit Logs (Immutable)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // System Configurations
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
